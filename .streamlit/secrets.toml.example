# Copy to .streamlit/secrets.toml and fill in. That file is gitignored.
# On Streamlit Community Cloud, paste these into Settings -> Secrets instead.
#
# ONE of these is required. Gemini is free and needs no billing setup.

GEMINI_API_KEY = "AIza..."          # from https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY = "sk-ant-..."  # requires prepaid credit

# Optional: "auto" (default), "gemini", or "anthropic".
# LLM_PROVIDER = "auto"

# Hard spend ceiling per audit run. The agent aborts loudly when exceeded.
MAX_TOKENS_PER_RUN = 250000
MAX_AGENT_ITERATIONS = 8
